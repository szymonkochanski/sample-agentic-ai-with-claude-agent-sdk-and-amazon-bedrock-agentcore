# Module 4 — Observability
# Copy to `.env` (gitignored). Used for local invoke/peek helpers. The DEPLOYED agent
# gets its env from agentcore.json `envVars`.

CLAUDE_CODE_USE_BEDROCK=1
ANTHROPIC_MODEL=global.anthropic.claude-sonnet-5-5
ANTHROPIC_SMALL_FAST_MODEL=global.anthropic.claude-haiku-5-5
AWS_REGION=us-west-2

# Run subagents in the foreground: newer Claude Code releases start them in the
# background, and the turn would end before their answer arrives.
CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1

# AWS credentials come from your standard AWS config (aws configure / SSO / env).
# To use a named AWS profile, uncomment the next line. A profile exported before
# you start Jupyter or your IDE takes precedence over this file.
# AWS_PROFILE=your-profile
